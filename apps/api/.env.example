# ==============================================================================
# AccessAI Backend (FastAPI) - Environment Configuration Template
# ==============================================================================
# Copy this file to apps/api/.env or set these in your container hosting platform
# (e.g. Railway, Render, Google Cloud Run, AWS ECS).
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list or JSON array of allowed origins)
# For production, specify your exact frontend domains.
CORS_ORIGINS=["https://accessai.vercel.app","http://localhost:3000"]

# PostgreSQL Database Connection
# In Supabase: Project Settings -> Database -> Connection string (URI)
# Use transaction pooler (port 6543) or direct connection (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API (Storage & Administration)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]
STORAGE_BUCKET=accessai-documents

# Clerk Authentication (RS256 JWT Verification)
# In Clerk Dashboard: API Keys
CLERK_SECRET_KEY=sk_live_[YOUR-CLERK-SECRET-KEY]
CLERK_PUBLISHABLE_KEY=pk_live_[YOUR-CLERK-PUBLISHABLE-KEY]
# Derived automatically from publishable key if omitted, or set explicitly:
CLERK_ISSUER=https://[YOUR-CLERK-FRONTEND-API]
CLERK_JWKS_URL=https://[YOUR-CLERK-FRONTEND-API]/.well-known/jwks.json
# Optional: direct PEM public key for offline verification without JWKS calls
CLERK_PEM_PUBLIC_KEY=

# Gemini AI Provider Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=[YOUR-GEMINI-API-KEY]
LLM_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Logging & Security
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60

