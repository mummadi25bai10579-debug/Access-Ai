# ==============================================================================
# AccessAI Frontend (Next.js 15) - Environment Configuration Template
# ==============================================================================
# Set these in your frontend hosting platform (e.g. Vercel Project Settings)
# or copy to apps/web/.env.local for local development.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_NAME="AccessAI"
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend API Endpoint (Full URL including /api/v1)
# Example production: https://api.accessai.org/api/v1
NEXT_PUBLIC_API_URL=https://api.accessai.org/api/v1

# Clerk Authentication (Client-side & Server Middleware)
# In Clerk Dashboard: API Keys -> Publishable Key & Secret Key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_[YOUR-CLERK-PUBLISHABLE-KEY]
CLERK_SECRET_KEY=sk_live_[YOUR-CLERK-SECRET-KEY]

# Optional Supabase Client (if querying public storage directly from browser)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

