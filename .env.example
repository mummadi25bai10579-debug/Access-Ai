# ==========================================
# AccessAI - Environment Configuration Template
# ==========================================

# Environment Mode: development | staging | production
APP_ENV=development
DEBUG=true

# ==========================================
# Frontend Configuration (apps/web)
# ==========================================
NEXT_PUBLIC_APP_NAME="AccessAI"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ==========================================
# Backend Configuration (apps/api)
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Supabase (Backend service key NEVER exposed to frontend)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
STORAGE_BUCKET=accessai-documents

# AI Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Multilingual Speech & OCR
BHASHINI_API_KEY=
BHASHINI_USER_ID=
OCR_ENGINE=paddleocr

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=change-this-in-production-to-a-secure-random-token
LOG_LEVEL=INFO
