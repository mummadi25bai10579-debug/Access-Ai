# ==============================================================================
# AccessAI - Root Environment Configuration Template
# ==============================================================================
# Master template for AccessAI monorepo (apps/api + apps/web).
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# Environment Mode: development | staging | production
APP_ENV=production
DEBUG=false

# ==========================================
# Frontend Configuration (apps/web)
# ==========================================
NEXT_PUBLIC_APP_NAME="AccessAI"
NEXT_PUBLIC_API_URL=https://api.accessai.org/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_[YOUR-CLERK-PUBLISHABLE-KEY]
CLERK_SECRET_KEY=sk_live_[YOUR-CLERK-SECRET-KEY]
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ==========================================
# Backend Configuration (apps/api)
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["https://accessai.vercel.app","http://localhost:3000"]

# Clerk Authentication (FastAPI JWT Signature Verification)
CLERK_PUBLISHABLE_KEY=pk_live_[YOUR-CLERK-PUBLISHABLE-KEY]
CLERK_SECRET_KEY=sk_live_[YOUR-CLERK-SECRET-KEY]
CLERK_ISSUER=https://[YOUR-CLERK-FRONTEND-API]
CLERK_JWKS_URL=https://[YOUR-CLERK-FRONTEND-API]/.well-known/jwks.json
CLERK_PEM_PUBLIC_KEY=

# Database & Supabase (Backend service key NEVER exposed to frontend)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]
STORAGE_BUCKET=accessai-documents

# AI Provider Configuration (Google Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=[YOUR-GEMINI-API-KEY]
LLM_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Document OCR & Multilingual Services
OCR_ENGINE=tesseract
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
